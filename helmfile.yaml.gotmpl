environments:
  default:
  dev:
  pro:

---

repositories:
- name: external-secrets
  url: https://charts.external-secrets.io

templates:
  default:
    chart: ./kubernetes/helm/charts/generic
    namespace: {{ .Environment.Name }}
    missingFileHandler: Warn
    values:
    - ./kubernetes/values/{{`{{ .Release.Name }}`}}/values.yaml
    - ./kubernetes/values/{{`{{ .Release.Name }}`}}/{{ .Environment.Name }}.yaml

releases:
# Application services
- name: vaultwarden
  inherit:
  - template: default
  needs:
  - external-secrets/external-secrets
  - restic-backup

- name: ittools
  inherit:
  - template: default

- name: tandem-backend
  inherit:
  - template: default
  needs:
  - external-secrets/external-secrets

- name: tandem-frontend
  inherit:
  - template: default
  needs:
  - external-secrets/external-secrets

# External Secrets Operator - Deploy first to enable secret management
- name: external-secrets
  namespace: external-secrets
  createNamespace: true
  chart: external-secrets/external-secrets
  version: 0.10.5
  values:
  - ./kubernetes/values/external-secrets/values.yaml

# Restic Backup - PVC backups to B2
- name: restic-backup
  chart: ./kubernetes/helm/charts/restic-backup
  namespace: {{ .Environment.Name }}
  needs:
  - external-secrets/external-secrets
  values:
  - ./kubernetes/values/restic-backup/apps/vaultwarden/{{ .Environment.Name }}.yaml

- name: restic-backup-tandem
  chart: ./kubernetes/helm/charts/restic-backup
  namespace: {{ .Environment.Name }}
  needs:
  - tandem-backend
  - external-secrets/external-secrets
  values:
  - ./kubernetes/values/restic-backup/apps/tandem/{{ .Environment.Name }}.yaml
