environments:
  default:
  dev:
  pro:

---

repositories:
- name: external-secrets
  url: https://charts.external-secrets.io

templates:
  default:
    chart: ./kubernetes/helm/charts/generic
    namespace: {{ .Environment.Name }}
    missingFileHandler: Warn
    values:
    - ./kubernetes/values/{{`{{ .Release.Name }}`}}/values.yaml
    - ./kubernetes/values/{{`{{ .Release.Name }}`}}/{{ .Environment.Name }}.yaml

releases:
# Application services
- name: vaultwarden
  inherit:
  - template: default
  needs:
  - external-secrets/external-secrets
  - restic-backup

- name: ittools
  inherit:
  - template: default

- name: home
  inherit:
  - template: default

{{ if eq .Environment.Name "pro" }}
- name: glances
  inherit:
  - template: default
{{ end }}

{{ if or (eq .Environment.Name "dev") (eq .Environment.Name "pro") }}
- name: anythingllm
  inherit:
  - template: default
{{ end }}
{{ if or (eq .Environment.Name "dev") (eq .Environment.Name "pro") }}
- name: forgejo
  inherit:
  - template: default
{{ end }}
{{ if eq .Environment.Name "pro" }}
- name: backrest
  inherit:
  - template: default
  needs:
  - external-secrets/external-secrets
{{ end }}
- name: postgres
  inherit:
  - template: default
  needs:
  - external-secrets/external-secrets

{{ if eq .Environment.Name "dev" }}
- name: grafana
  inherit:
  - template: default
  needs:
  - external-secrets/external-secrets
  - postgres
{{ end }}

- name: tandem-backend
  inherit:
  - template: default
  needs:
  - external-secrets/external-secrets

- name: tandem-frontend
  inherit:
  - template: default
  needs:
  - external-secrets/external-secrets

# External Secrets Operator - Deploy first to enable secret management
- name: external-secrets
  namespace: external-secrets
  createNamespace: true
  chart: external-secrets/external-secrets
  version: 0.10.5
  values:
  - ./kubernetes/values/external-secrets/values.yaml

# Restic Backup - PVC backups to B2
- name: restic-backup
  chart: ./kubernetes/helm/charts/restic-backup
  namespace: {{ .Environment.Name }}
  needs:
  - external-secrets/external-secrets
  values:
  - ./kubernetes/values/restic-backup/apps/vaultwarden/{{ .Environment.Name }}.yaml

- name: restic-backup-tandem
  chart: ./kubernetes/helm/charts/restic-backup
  namespace: {{ .Environment.Name }}
  needs:
  - tandem-backend
  - external-secrets/external-secrets
  values:
  - ./kubernetes/values/restic-backup/apps/tandem/{{ .Environment.Name }}.yaml

{{ if or (eq .Environment.Name "dev") (eq .Environment.Name "pro") }}
- name: restic-backup-anythingllm
  chart: ./kubernetes/helm/charts/restic-backup
  namespace: {{ .Environment.Name }}
  needs:
  - anythingllm
  - external-secrets/external-secrets
  values:
  - ./kubernetes/values/restic-backup/apps/anythingllm/{{ .Environment.Name }}.yaml

- name: restic-backup-forgejo
  chart: ./kubernetes/helm/charts/restic-backup
  namespace: {{ .Environment.Name }}
  needs:
  - forgejo
  - external-secrets/external-secrets
  values:
  - ./kubernetes/values/restic-backup/apps/forgejo/{{ .Environment.Name }}.yaml
{{ end }}

{{ if eq .Environment.Name "dev" }}
- name: restic-backup-postgres
  chart: ./kubernetes/helm/charts/restic-backup
  namespace: {{ .Environment.Name }}
  needs:
  - postgres
  - external-secrets/external-secrets
  values:
  - ./kubernetes/values/restic-backup/apps/postgres/{{ .Environment.Name }}.yaml

- name: restic-backup-grafana
  chart: ./kubernetes/helm/charts/restic-backup
  namespace: {{ .Environment.Name }}
  needs:
  - grafana
  - external-secrets/external-secrets
  values:
  - ./kubernetes/values/restic-backup/apps/grafana/{{ .Environment.Name }}.yaml
{{ end }}
