        "schedule": {
          "cron": "0 1 * * *",
          "clock": "CLOCK_UTC"
        },
        "retention": {
          "policyTimeBucketed": {
            "daily": 7,
            "weekly": 4,
            "monthly": 6,
            "yearly": 1
          }
        }
      },
      "hooks": [
        {
          "conditions": [
            "CONDITION_ANY_ERROR"
          ],
          "actionCommand": {
            "command": "curl -fsS -m 30 -H 'Title: Backrest {{ .Repo.Id }} failed' -H 'Priority: high' -H 'Tags: warning' -d {{ .ShellEscape .Summary }} \"https://ntfy.sh/${NTFY_TOPIC}\""
