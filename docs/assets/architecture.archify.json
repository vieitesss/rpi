  "cards": [
    {
      "dot": "cyan",
      "title": "Environments",
      "items": [
        "pro is always on, served as https://<service>.<tailnet>.ts.net",
        "dev runs on demand on the Pi's own tailnet name",
        "Image tags are tested in dev, then copied into pro"
      ]
    },
    {
      "dot": "rose",
      "title": "Secrets",
      "items": [
        "Pulled from GCP Secret Manager only on deploy",
        "Written to a 0600 env file, never polled",
        "Only Backrest receives them (B2, restic, ntfy)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Guardrails",
      "items": [
        "Every container has a mem_limit",
        "Ports bind to 127.0.0.1; only tailscaled exposes them",
        "Backup failures alert through ntfy"
      ]
    }
  ]
