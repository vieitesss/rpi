[Unit]
Description=Raspberry Pi Docker Volumes Backup
After=docker.service rpi-services.service
Requires=docker.service

[Service]
Type=oneshot
User=%i
Group=%i
WorkingDirectory=/home/%i/rpi
ExecStart=/bin/bash docker-compose/scripts/backup.sh

# Security settings
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
