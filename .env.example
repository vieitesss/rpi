# Copy to .env (untracked) and fill in. Read by `just` and the boot/shutdown scripts.

# Tailnet DNS name (Tailscale admin console > DNS), e.g. example-tailnet.ts.net
TAILNET_DOMAIN=
# This host's machine name in the tailnet; dev is served on https://<host>.<domain>:<port>
TAILNET_HOST=
# GCP project holding the secrets in docs/security.md
GCP_PROJECT=
# Backblaze B2 bucket for the restic repositories
B2_BUCKET=
# ntfy.sh topic for the boot and shutdown notifications (optional)
NTFY=
